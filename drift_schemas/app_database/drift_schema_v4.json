  "fixed_sql": [
    {
      "name": "folders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"folders\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "documents",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"documents\" (\"id\" TEXT NOT NULL, \"folder_id\" TEXT NULL REFERENCES folders (id) ON DELETE SET NULL, \"title\" TEXT NOT NULL, \"page_count\" INTEGER NOT NULL DEFAULT 0, \"pdf_path\" TEXT NULL, \"thumbnail_path\" TEXT NULL, \"file_size\" INTEGER NOT NULL DEFAULT 0, \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pages\" (\"id\" TEXT NOT NULL, \"document_id\" TEXT NOT NULL REFERENCES documents (id) ON DELETE CASCADE, \"page_order\" INTEGER NOT NULL, \"original_path\" TEXT NOT NULL, \"processed_path\" TEXT NULL, \"thumbnail_path\" TEXT NULL, \"width\" INTEGER NOT NULL, \"height\" INTEGER NOT NULL, \"rotation\" INTEGER NOT NULL DEFAULT 0, \"filter_type\" TEXT NOT NULL DEFAULT 'original', \"crop_corners\" TEXT NULL, \"brightness\" REAL NOT NULL DEFAULT 0.0, \"contrast\" REAL NOT NULL DEFAULT 0.0, \"sharpness\" REAL NOT NULL DEFAULT 0.0, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "page_ocr",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"page_ocr\" (\"id\" TEXT NOT NULL, \"page_id\" TEXT NOT NULL REFERENCES pages (id) ON DELETE CASCADE, \"extracted_text\" TEXT NOT NULL DEFAULT '', \"detected_language\" TEXT NULL, \"engine\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'pending', \"updated_at\" INTEGER NOT NULL, \"lines\" TEXT NULL, \"error_message\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
